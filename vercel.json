{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/recommend.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/style.css",
      "use": "@vercel/static"
    },
    {
      "src": "js/app.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/recommend",
      "dest": "/api/recommend.py"
    }
  ]
}